{
  "name": "bursa-frontend",
  "private": true,
  "license": "MIT",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware --deny-warnings src",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "gen:favicons": "node scripts/gen-favicons.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "tsc --noEmit && npm run lint && prettier --check . && vitest run"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.3",
    "@zxcvbn-ts/core": "4.2.0",
    "@zxcvbn-ts/language-common": "4.1.3",
    "@zxcvbn-ts/language-en": "4.1.1",
    "axios": "^1.20.0",
    "lightweight-charts": "^4.2.3",
    "lucide-react": "^1.57.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "7.0.2003",
    "prettier": "^3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "^7.0.2",
    "vite": "^6.4.4",
    "vitest": "5.0.3"
  }
}

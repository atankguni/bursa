# Bursa backend settings: copy to backend/.env and fill in what you need.
#
#   cp backend/.env.example backend/.env
#
# Everything is optional: the app runs with the defaults shown (commented out).
# backend/.env holds secrets; it is git-ignored and kept out of the Docker image,
# so never commit it. All settings, including tuning knobs not listed here, are
# in backend/config.py; see docs/configuration.md.

# --- Accounts -----------------------------------------------------------------
# Where people open the app: used in invite / reset links and for the
# cross-site request check. Set it to your real address when deploying.
# PUBLIC_URL=http://localhost:5173
# Set true when served over HTTPS (required for a public deployment).
# SESSION_COOKIE_SECURE=false
# SESSION_DAYS=30
# INVITE_DAYS=7
# PASSWORD_RESET_HOURS=2
# LOGIN_MAX_FAILURES=10
# LOGIN_WINDOW_MINUTES=15

# Password policy: minimum length, strength (zxcvbn score 0-4), and refusing
# passwords leaked in data breaches (only 5 characters of the SHA-1 hash are sent).
# PASSWORD_MIN_LENGTH=12
# PASSWORD_MIN_SCORE=3
# PASSWORD_BREACH_CHECK=true

# --- Two-factor authentication ----------------------------------------------------
# Server secret (at least 32 characters) that encrypts authenticator secrets.
# Unset: generated once into data/secret.key. Back up whichever you use together
# with the database: without it, every user's 2FA has to be reset.
# SECRET_KEY=
# MFA_ISSUER=Bursa
# TRUSTED_DEVICE_DAYS=30

# --- AI assistant (optional) --------------------------------------------------------
# Free key from Google AI Studio. Without it, the assistant is disabled.
GEMINI_API_KEY=
# ASSISTANT_DAILY_LIMIT=100
# Default for users who haven't chosen: may the assistant read their watchlist
# and portfolio? (Sent to the AI provider.)
# ASSISTANT_PERSONAL_DATA=false
# Saved chats are deleted this many days after their last message.
# ASSISTANT_CHAT_DAYS=90

# --- Email (optional): 2FA codes, invites, password resets, security notices --------
# Provider: smtp, resend, or console (development only: emails are printed to the
# backend log instead of sent; works only while PUBLIC_URL is localhost).
# MAIL_PROVIDER=smtp
# MAIL_FROM=Bursa <bursa@example.com>
# MAIL_TO=you@example.com

# SMTP (Gmail app password, Outlook, Zoho, Brevo, ...)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# starttls (587), ssl (465) or none (local relay)
# SMTP_SECURITY=starttls

# Resend (needs a verified sender domain)
# RESEND_API_KEY=

# --- Telegram alerts (optional) ---------------------------------------------------
# Token from @BotFather; the chat id of your own chat with the bot.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# --- Database ---------------------------------------------------------------------
# Docker Compose sets SQLite on the data volume. PostgreSQL / MySQL also work
# (the image then needs the DB_DRIVER build argument; see docs/configuration.md):
#   postgresql+asyncpg://user:pass@host:5432/bursa
#   mysql+aiomysql://user:pass@host:3306/bursa
# DATABASE_URL=sqlite+aiosqlite:///./data/bursa.db
# Nightly SQLite backup (database + secret.key), newest BACKUP_KEEP kept. They sit
# next to the database: copy data/backups/ elsewhere too.
# BACKUP_ENABLED=true
# BACKUP_DIR=./data/backups
# BACKUP_KEEP=7

# --- Market data ------------------------------------------------------------------
# TIMEZONE=Asia/Jakarta
# Years of daily prices stored per stock (used by charts and the signal backtest).
# DAILY_HISTORY_YEARS=5
# Browser origins allowed to call the API directly (JSON list).
# CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
